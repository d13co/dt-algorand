# tt-snapshot.service: settings for dt_snapshot.sh (run it with --help for all of them) and the
# R2 upload. Read by systemd and by the scripts with `set -a; . <this file>`: plain KEY=value only.

# snapshot tree on local disk, mirrored to the bucket; ttsnap publish dedups against its blobs
OUT=/srv/snapshots
# Falcon-1024 producer key (key id af039a3b8ceea3e1, "d13 producer" in the package's keys file)
KEY=/root/ttsnap_key
ROOT=/mnt/dtalgod-mainnet-hot-root
TTSNAP=/usr/local/lib/tt-snapshot/ttsnap
# btrfs snapshots of @live to keep: one is enough once published, and each pins blocks the node rewrites
KEEP=1
# published snapshots to keep in OUT and the bucket (the latest, and the one before for slow downloads)
GC_KEEP=2
UPLOAD=/usr/local/lib/tt-snapshot/upload.sh

# R2 bucket, served at R2_PUBLIC_URL through its custom domain
R2_BUCKET=tt-snapshots-mainnet
R2_PUBLIC_URL=https://tt-snapshots-mainnet.d13.co
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://FILL_IN_ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=FILL_IN_ACCESS_KEY_ID
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=FILL_IN_SECRET_ACCESS_KEY
# the token is scoped to the bucket, so rclone must not try to create it
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# no rclone.conf: the remote is defined by the variables above
RCLONE_CONFIG=/dev/null
