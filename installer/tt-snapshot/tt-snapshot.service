[Unit]
Description=Publish a ttsnap history snapshot of the mainnet time travel node to R2
Wants=network-online.target
After=network-online.target dtalgorand.service
# mounts for the env file's ROOT and OUT: setup.sh writes tt-snapshot.service.d/paths.conf
# tt-snapshot-trigger starts it once per catchpoint, and again 30 minutes after a run that failed
# or fell short

[Service]
Type=oneshot
EnvironmentFile=/etc/tt-snapshot.env
ExecStart=/usr/local/lib/tt-snapshot/dt_snapshot.sh
# when the run ended, which the trigger's retry waits from: systemd forgets it once a run succeeds
RuntimeDirectory=tt-snapshot
RuntimeDirectoryPreserve=yes
ExecStopPost=-/usr/bin/touch /run/tt-snapshot/%n.ended
# the commitment uses every CPU for minutes: let the nodes on this box go first
Nice=10
CPUWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=20
TimeoutStartSec=12h
