## For some data directory $ALGORAND_DATA
##
## Setup:
## ALGORAND_DATA=/var/lib/ttalgorand_testnet
## sudo mkdir -p ${ALGORAND_DATA}
## sudo cp -p /var/lib/ttalgorand/genesis/testnet/genesis.json ${ALGORAND_DATA}/genesis.json
## sudo cp -p /var/lib/ttalgorand/system.json ${ALGORAND_DATA}/system.json
## echo '{ "EnableTimeTravel": true }' | sudo tee ${ALGORAND_DATA}/config.json
## sudo chown -R ttalgorand:ttalgorand ${ALGORAND_DATA}
##
## systemd allows for config overrides in a .conf file under a directory named for the service. e.g.:
##
## sudo systemctl edit ttalgorand@$(systemd-escape ${ALGORAND_DATA})
##
## sudo systemctl enable ttalgorand@$(systemd-escape ${ALGORAND_DATA})
## sudo systemctl start ttalgorand@$(systemd-escape ${ALGORAND_DATA})


[Unit]
Description=Algorand time travel daemon for %I
After=network.target

[Service]
ExecStart=/usr/bin/ttalgod -d %I
PIDFile=%I/algod.pid
User=ttalgorand
Group=ttalgorand
Restart=always
RestartSec=5s
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
