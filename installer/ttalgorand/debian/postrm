#!/bin/sh
set -e

## cat /usr/share/debhelper/autoscripts/postrm-systemd | sed -e s,#UNITFILES#,ttalgorand.service,
if [ "$1" = "remove" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper mask ttalgorand.service >/dev/null || true
	fi
fi

if [ "$1" = "purge" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper purge ttalgorand.service >/dev/null || true
		deb-systemd-helper unmask ttalgorand.service >/dev/null || true
	fi
fi

## cat /usr/share/debhelper/autoscripts/postrm-systemd-reload-only | sed -e s,#UNITFILES#,ttalgorand.service,
if [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload >/dev/null || true
fi
