[Unit]
Description=Algorand time travel daemon for mainnet in /var/lib/dtalgorand
After=network.target

[Service]
ExecStart=/usr/bin/dtalgod -d /var/lib/dtalgorand
PIDFile=/var/lib/dtalgorand/algod.pid
User=dtalgorand
Group=dtalgorand
Restart=always
RestartSec=5s
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
