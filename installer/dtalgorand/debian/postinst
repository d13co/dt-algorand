#!/bin/sh
set -e

# algod and goal keep files in $HOME/.algorand, so the home is the data directory,
# as the algorand package does for its algorand user.
adduser --system --group --home /var/lib/dtalgorand --no-create-home dtalgorand >/dev/null

if [ "$1" = "configure" ]; then
    # A node that synced without time travel cannot turn it on later, so a new
    # install starts with it on, and with the asset holders index (built with
    # ttimport -holders-index, which refuses unless the config sets it).
    if [ -z "$2" ] && [ ! -e /var/lib/dtalgorand/config.json ]; then
        printf '{\n    "EnableTimeTravel": true,\n    "TimeTravelHoldersIndex": true\n}\n' > /var/lib/dtalgorand/config.json
    fi
    chown -R dtalgorand:dtalgorand /var/lib/dtalgorand
fi

## cat /usr/share/debhelper/autoscripts/postinst-systemd-dont-enable | sed -e s,#UNITFILE#,dtalgorand.service,
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed dtalgorand.service; then
		# This will only remove masks created by d-s-h on package removal.
		deb-systemd-helper unmask dtalgorand.service >/dev/null || true

		if deb-systemd-helper --quiet was-enabled dtalgorand.service; then
			# Create new symlinks, if any.
			deb-systemd-helper enable dtalgorand.service >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be
	# cleaned up on purge. Also remove old symlinks.
	deb-systemd-helper update-state dtalgorand.service >/dev/null || true
fi

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			# restart the nodes that are running, and only those
			deb-systemd-invoke try-restart dtalgorand.service 'dtalgorand@*.service' >/dev/null || true
		fi
	fi
fi
